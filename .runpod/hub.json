{
  "description": "CosyVoice 2 is a next-gen TTS model with natural prosody and voice cloning. Supports multi-speaker synthesis, emotion control, and voice cloning from short audio samples. API: POST JSON with {text, reference_audio, voice, emotion} -> {audio_base64, text, voice, wall_time_s}. GPU: requires >=8GB VRAM (RTX 4090, L40S, A5000+).",
  "category": "audio",
  "type": "serverless",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 20,
    "gpuCount": 1,
    "gpuIds": "ADA_24,ADA_48,AMPERE_48",
    "allowedCudaVersions": [
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ],
    "env": [
      {
        "key": "PYTORCH_CUDA_ALLOC_CONF",
        "value": "expandable_segments:True"
      }
    ],
    "presets": [
      {
        "name": "Default (neutral emotion)",
        "defaults": {
          "VOICE": "default",
          "EMOTION": "neutral"
        }
      },
      {
        "name": "Expressive (happy emotion)",
        "defaults": {
          "VOICE": "default",
          "EMOTION": "happy"
        }
      }
    ]
  },
