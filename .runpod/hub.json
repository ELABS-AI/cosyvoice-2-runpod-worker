{
  "title": "elabs / CosyVoice 2 TTS",
  "description": "Zero-shot voice cloning TTS using Alibaba CosyVoice 2. Supports multi-speaker synthesis, emotion control, and voice cloning from 3-10s reference audio. Input: {text, reference_audio_b64, voice, emotion} \u2192 Output: {audio_b64, wall_time_s}.",
  "category": "audio",
  "type": "serverless",
  "iconUrl": "https://pub-796a08821c1c483aaf5e274e0d03e350.r2.dev/hub-icons/cosyvoice.svg",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 20,
    "gpuCount": 1,
    "gpuIds": "ADA_24,ADA_48_PRO,AMPERE_24",
    "allowedCudaVersions": [
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ],
    "env": [
      {
        "key": "MODEL_ID",
        "value": "iic/CosyVoice2-0.5B"
      },
      {
        "key": "HF_HOME",
        "value": "/runpod-volume/models/huggingface"
      },
      {
        "key": "PYTORCH_CUDA_ALLOC_CONF",
        "value": "expandable_segments:True"
      }
    ]
  }
}